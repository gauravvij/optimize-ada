[claude:event system] {"type":"system","subtype":"task_started","task_id":"bcwhk4u21","tool_use_id":"toolu_01Ew8qHcZ29JDcTYgXhvTeRe","description":"\ncd /tmp/test-repo\n\n# Clean up the mess\ngit checkout main\ngit reset --hard HEAD~1\n\n# Now do a clean timing test\nexport GIT_SSH_COMMAND=\"sshpass -p password ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null\"\n\necho \"Testing deployment timing...\"\ntimestamp=$(date +%s%N)\necho \"Timestamp: $timestamp\" > index.html\necho \"main branch content\" >> index.html\n\ngit add index.html\ngit commit -m \"Timing test with timestamp\"\n\n# Record start time\nstart_time=$(date +%s%N)\n\n# Push the commit (this triggers post-receive hook)\ngit push origin main 2>&1 | grep -E \"To |error\"\n\n# Poll for deployment (max 3 seconds)\ndeployed=false\nfor i in {1..30}; do\n    if grep -q \"$timestamp\" /var/www/main/index.html 2>/dev/null; then\n        end_time=$(date +%s%N)\n        elapsed_ms=$((($end_time - $start_time) / 1000000))\n        echo \"✓ Deployment completed in ${elapsed_ms}ms\"\n        deployed=true\n        break\n    fi\n    sleep 0.1\ndone\n\nif [ \"$deployed\" = false ]; then\n    echo \"✗ Deployment did not complete within 3 seconds\"\nfi\n\n# Show final content\necho \"\"\necho \"Deployed content:\"\ncat /var/www/main/index.html\n","is_backgrounded":false,"task_type":"local_bash","uuid":"8ff14a45-ab3b-4c8f-9199-27166e463a46","session_id":"3c6163d3-0f96-40e5-b7b7-c26812f62f65"}
[claude:event system] {"type":"system","subtype":"task_notification","task_id":"bcwhk4u21","tool_use_id":"toolu_01Ew8qHcZ29JDcTYgXhvTeRe","status":"completed","output_file":"","summary":"\ncd /tmp/test-repo\n\n# Clean up the mess\ngit checkout main\ngit reset --hard HEAD~1\n\n# Now do a clean timing test\nexport GIT_SSH_COMMAND=\"sshpass -p password ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null\"\n\necho \"Testing deployment timing...\"\ntimestamp=$(date +%s%N)\necho \"Timestamp: $timestamp\" > index.html\necho \"main branch content\" >> index.html\n\ngit add index.html\ngit commit -m \"Timing test with timestamp\"\n\n# Record start time\nstart_time=$(date +%s%N)\n\n# Push the commit (this triggers post-receive hook)\ngit push origin main 2>&1 | grep -E \"To |error\"\n\n# Poll for deployment (max 3 seconds)\ndeployed=false\nfor i in {1..30}; do\n    if grep -q \"$timestamp\" /var/www/main/index.html 2>/dev/null; then\n        end_time=$(date +%s%N)\n        elapsed_ms=$((($end_time - $start_time) / 1000000))\n        echo \"✓ Deployment completed in ${elapsed_ms}ms\"\n        deployed=true\n        break\n    fi\n    sleep 0.1\ndone\n\nif [ \"$deployed\" = false ]; then\n    echo \"✗ Deployment did not complete within 3 seconds\"\nfi\n\n# Show final content\necho \"\"\necho \"Deployed content:\"\ncat /var/www/main/index.html\n","uuid":"cf095339-e2ab-4bb5-ae31-7949b909d8b2","session_id":"3c6163d3-0f96-40e5-b7b7-c26812f62f65"}
