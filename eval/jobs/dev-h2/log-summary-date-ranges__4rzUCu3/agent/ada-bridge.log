[claude:event system] {"type":"system","subtype":"task_started","task_id":"ba2wvjs75","tool_use_id":"toolu_01AfG3nUNDui5drzZhGK9TvC","description":"cat > /tmp/analyze_logs.sh << 'EOF'\n#!/bin/bash\n\n# Reference date\nref_date=\"2025-08-12\"\n\n# Convert date to days since epoch for comparison\ndate_to_days() {\n    date -d \"$1\" +%s | awk '{print int($1 / 86400)}'\n}\n\nref_days=$(date_to_days \"$ref_date\")\ntoday_days=$ref_days\nseven_days_ago=$(date -d \"2025-08-12 - 7 days\" +%Y-%m-%d)\nseven_days_ago_days=$(date_to_days \"$seven_days_ago\")\nthirty_days_ago=$(date -d \"2025-08-12 - 30 days\" +%Y-%m-%d)\nthirty_days_ago_days=$(date_to_days \"$thirty_days_ago\")\nmonth_start=\"2025-08-01\"\nmonth_start_days=$(date_to_days \"$month_start\")\n\n# Initialize counters\ndeclare -A counters\n\n# Severity levels\nfor severity in ERROR WARNING INFO; do\n    for period in today last_7_days last_30_days month_to_date total; do\n        counters[\"${period}_${severity}\"]=0\n    done\ndone\n\n# Process all log files\nfor logfile in /app/logs/*.log; do\n    # Extract date from filename (YYYY-MM-DD_<source>.log)\n    filename=$(basename \"$logfile\")\n    file_date=\"${filename:0:10}\"\n    \n    # Skip if filename doesn't match pattern\n    if [[ ! $file_date =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then\n        continue\n    fi\n    \n    file_days=$(date_to_days \"$file_date\")\n    \n    # Determine which date ranges this file belongs to\n    is_today=0\n    is_last_7=0\n    is_last_30=0\n    is_month_to_date=0\n    \n    if [ \"$file_days\" -eq \"$today_days\" ]; then\n        is_today=1\n    fi\n    \n    if [ \"$file_days\" -ge \"$seven_days_ago_days\" ] && [ \"$file_days\" -le \"$today_days\" ]; then\n        is_last_7=1\n    fi\n    \n    if [ \"$file_days\" -ge \"$thirty_days_ago_days\" ] && [ \"$file_days\" -le \"$today_days\" ]; then\n        is_last_30=1\n    fi\n    \n    if [ \"$file_days\" -ge \"$month_start_days\" ] && [ \"$file_days\" -le \"$today_days\" ]; then\n        is_month_to_date=1\n    fi\n    \n    # Count each severity in this file\n    for severity in ERROR WARNING INFO; do\n        count=$(grep -c \"\\[$severity\\]\" \"$logfile\" 2>/dev/null || echo 0)\n        \n        # Add to total\n        counters[\"total_${severity}\"]=$((${counters[\"total_${severity}\"]} + count))\n        \n        # Add to other periods if applicable\n        if [ \"$is_today\" -eq 1 ]; then\n            counters[\"today_${severity}\"]=$((${counters[\"today_${severity}\"]} + count))\n        fi\n        \n        if [ \"$is_last_7\" -eq 1 ]; then\n            counters[\"last_7_days_${severity}\"]=$((${counters[\"last_7_days_${severity}\"]} + count))\n        fi\n        \n        if [ \"$is_last_30\" -eq 1 ]; then\n            counters[\"last_30_days_${severity}\"]=$((${counters[\"last_30_days_${severity}\"]} + count))\n        fi\n        \n        if [ \"$is_month_to_date\" -eq 1 ]; then\n            counters[\"month_to_date_${severity}\"]=$((${counters[\"month_to_date_${severity}\"]} + count))\n        fi\n    done\ndone\n\n# Output CSV\necho \"period,severity,count\"\nfor period in today last_7_days last_30_days month_to_date total; do\n    for severity in ERROR WARNING INFO; do\n        echo \"${period},${severity},${counters[\"${period}_${severity}\"]}\"\n    done\ndone\nEOF\n\nchmod +x /tmp/analyze_logs.sh\n/tmp/analyze_logs.sh\n","is_backgrounded":false,"task_type":"local_bash","uuid":"992e455b-9902-4efe-95ca-34bfec0b4af6","session_id":"743a8e29-e291-4ada-8406-ae64045bd4fd"}
