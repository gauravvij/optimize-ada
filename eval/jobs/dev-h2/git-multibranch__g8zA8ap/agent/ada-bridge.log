L - Expected 'dev branch content', got '$RESULT'\"\nfi\n\necho \"\"\necho \"=== TEST COMPLETE ===\"\n","is_backgrounded":false,"task_type":"local_bash","uuid":"cfdacaf5-a07c-406f-9fdd-324a97f3eccb","session_id":"bff72887-ec62-4bb5-9d77-efa05c46d32c"}
