{
    "job_name": "dev-h1",
    "jobs_dir": "/root/optimize_ada/eval/jobs",
    "n_attempts": 4,
    "n_concurrent_trials": 2,
    "environment": {
        "type": "docker",
        "mounts": [
            {
                "type": "bind",
                "source": "/root/optimize_ada/eval/ada-runtime",
                "target": "/ada-runtime"
            }
        ]
    },
    "agents": [
        {
            "name": "eval.ada-agent.ada_agent:AdaBridgeAgent",
            "model_name": "anthropic/claude-haiku-4-5",
            "kwargs": {
                "hook_verify_gate": 1,
                "lever_debug": 1
            }
        }
    ],
    "datasets": [
        {
            "name": "terminal-bench",
            "version": "2.0",
            "task_names": [
                "cancel-async-tasks",
                "fix-git",
                "git-multibranch",
                "large-scale-text-editing",
                "log-summary-date-ranges",
                "openssl-selfsigned-cert",
                "regex-log",
                "sanitize-git-repo",
                "fix-code-vulnerability",
                "git-leak-recovery"
            ]
        }
    ]
}