[claude:event system] {"type":"system","subtype":"task_started","task_id":"bmvwqer8s","tool_use_id":"toolu_01FXvbvptJxyN2Fm1pTDTd5y","description":"cd /tmp && cat > git_server_setup.sh << 'EOF'\n#!/bin/bash\nset -e\n\n# Install required packages\napt-get update > /dev/null 2>&1\napt-get install -y git openssh-server openssh-client nginx openssl curl > /dev/null 2>&1\n\n# Create git user\nif ! id -u git > /dev/null 2>&1; then\n    useradd -m -s /bin/bash git\nfi\n\n# Configure SSH\nmkdir -p /etc/ssh\nsed -i 's/#PasswordAuthentication no/PasswordAuthentication yes/' /etc/ssh/sshd_config || true\nsed -i 's/PasswordAuthentication no/PasswordAuthentication yes/' /etc/ssh/sshd_config || true\n\n# Set git user password\necho \"git:password\" | chpasswd\n\n# Start SSH service\nservice ssh restart > /dev/null 2>&1 || systemctl start ssh > /dev/null 2>&1 || true\n\n# Create git repository directory\nmkdir -p /git\ncd /git\n\n# Initialize bare repository\nif [ ! -d project.git ]; then\n    git init --bare project.git\n    chown -R git:git project.git\n    chmod -R 755 project.git\nfi\n\n# Create post-receive hook\ncat > project.git/hooks/post-receive << 'HOOK'\n#!/bin/bash\n\nwhile read oldrev newrev refname; do\n    branch=$(basename $refname)\n    \n    # Deploy main branch to /var/www/main\n    if [ \"$branch\" = \"main\" ]; then\n        mkdir -p /var/www/main\n        git --work-tree=/var/www/main --git-dir=/git/project.git checkout -f main\n        chmod -R 755 /var/www/main\n    fi\n    \n    # Deploy dev branch to /var/www/dev\n    if [ \"$branch\" = \"dev\" ]; then\n        mkdir -p /var/www/dev\n        git --work-tree=/var/www/dev --git-dir=/git/project.git checkout -f dev\n        chmod -R 755 /var/www/dev\n    fi\ndone\nHOOK\n\nchmod +x project.git/hooks/post-receive\nchown git:git project.git/hooks/post-receive\n\n# Create Nginx directories\nmkdir -p /var/www/main /var/www/dev\nchmod -R 755 /var/www\n\n# Generate self-signed certificate\nmkdir -p /etc/nginx/certs\nopenssl req -x509 -newkey rsa:2048 -keyout /etc/nginx/certs/key.pem -out /etc/nginx/certs/cert.pem -days 365 -nodes -subj \"/CN=localhost\" 2>/dev/null\n\n# Configure Nginx\ncat > /etc/nginx/sites-available/default << 'NGINX'\nserver {\n    listen 8443 ssl;\n    server_name localhost;\n    \n    ssl_certificate /etc/nginx/certs/cert.pem;\n    ssl_certificate_key /etc/nginx/certs/key.pem;\n    ssl_protocols TLSv1.2 TLSv1.3;\n    \n    # Main branch\n    location = /index.html {\n        alias /var/www/main/index.html;\n    }\n    \n    location / {\n        root /var/www/main;\n        try_files $uri $uri/ =404;\n    }\n    \n    # Dev branch\n    location /dev/ {\n        alias /var/www/dev/;\n        index index.html;\n    }\n}\nNGINX\n\n# Enable site\nln -sf /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default 2>/dev/null || true\n\n# Start Nginx\nsystemctl restart nginx > /dev/null 2>&1 || service nginx restart > /dev/null 2>&1 || true\n\necho \"Git server setup complete!\"\necho \"Git repository: /git/project.git\"\necho \"SSH: git@localhost:/git/project\"\necho \"Nginx: https://localhost:8443/\"\nEOF\n\nchmod +x git_server_setup.sh\n./git_server_setup.sh\n","is_backgrounded":false,"task_type":"local_bash","uuid":"6c0c423e-ba85-46d3-b99d-6c70f03c315c","session_id":"4dde8158-4dad-42cf-8930-f9903e9e61eb"}
