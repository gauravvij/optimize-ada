[claude:event system] {"type":"system","subtype":"task_started","task_id":"bihiyh1s4","tool_use_id":"toolu_016XySHtqVvGHzB5CSGZsouE","description":"\n# Install sshpass for password-based SSH\napt-get update -qq > /dev/null 2>&1\napt-get install -y sshpass > /dev/null 2>&1\n\necho \"Testing direct SSH login with sshpass...\"\nsshpass -p password ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null git@localhost \"echo SSH login successful\"\n\n# Check exit code\nif [ $? -eq 0 ]; then\n  echo \"SSH login successful!\"\nelse\n  echo \"SSH login failed with exit code $?\"\nfi\n","is_backgrounded":false,"task_type":"local_bash","uuid":"20672249-8157-4b82-ba66-d8c1a9b30680","session_id":"f3c360ef-f44a-499f-b825-ad511b87a24c"}
