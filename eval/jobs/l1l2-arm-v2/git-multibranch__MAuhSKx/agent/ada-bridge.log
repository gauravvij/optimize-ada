[claude:event system] {"type":"system","subtype":"task_started","task_id":"bl8d6afvr","tool_use_id":"toolu_01BRtcvufMNVzYq6nGRJMXWg","description":"\n# Check if sshd is actually reading the password auth config\nsshd -T 2>/dev/null | grep -i password || echo \"Could not get sshd config\"\n\n# Try to SSH in directly to test password auth (using echo to pipe password)\necho \"Testing SSH with password using nc...\"\n\n# Create a simple SSH login test script\ncat > /tmp/test_ssh.sh << 'EOF'\n#!/bin/bash\nexec 3<>/dev/tcp/localhost/22\necho \"SSH CONNECTION TEST\"\ncat <&3\nEOF\n\nchmod +x /tmp/test_ssh.sh\nbash /tmp/test_ssh.sh 2>&1 | head -5\n","is_backgrounded":false,"task_type":"local_bash","uuid":"b5a93ff2-1cb6-4963-afaf-c207e5fdde17","session_id":"f3c360ef-f44a-499f-b825-ad511b87a24c"}
