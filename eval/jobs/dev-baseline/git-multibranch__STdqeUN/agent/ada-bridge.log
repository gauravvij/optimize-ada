[claude:event system] {"type":"system","subtype":"task_started","task_id":"bce4qhvct","tool_use_id":"toolu_014wxvwkjnPifZGvvJ8RVGxr","description":"\n# Test cloning the repository\ncd /tmp\n\n# Create SSH config to allow connection without key verification\nmkdir -p ~/.ssh\ncat > ~/.ssh/config << 'EOF'\nHost localhost\n    StrictHostKeyChecking no\n    UserKnownHostsFile=/dev/null\n    PasswordAuthentication yes\nEOF\n\nchmod 600 ~/.ssh/config\n\n# Install sshpass to handle password authentication\napt-get update > /dev/null 2>&1\napt-get install -y sshpass > /dev/null 2>&1\n\necho \"Setup complete. Testing clone...\"\n\n# Test clone with password authentication\nsshpass -p password git clone ssh://git@localhost:/git/project test-repo 2>&1 || echo \"Clone attempt completed\"\n","is_backgrounded":false,"task_type":"local_bash","uuid":"68e34c49-a935-4b33-9d59-7706ca048bbc","session_id":"344cb2dd-95ae-4693-bd95-fa8027faa83f"}
