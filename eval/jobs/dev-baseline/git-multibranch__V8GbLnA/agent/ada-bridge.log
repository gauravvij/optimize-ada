[claude:event system] {"type":"system","subtype":"task_started","task_id":"bxazdx8ij","tool_use_id":"toolu_01GmNDRAQ7uaQqXCBF4famJV","description":"\n# Test SSH access with password (using sshpass)\nwhich sshpass || (apt-get update -qq && apt-get install -y sshpass > /dev/null 2>&1)\n\n# Test git clone over SSH with password\ncd /tmp\nrm -rf test-repo-ssh\nmkdir test-repo-ssh\ncd test-repo-ssh\n\n# This will clone using SSH with password auth\nGIT_SSH_COMMAND=\"ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null\" \\\nsshpass -p \"password\" git clone ssh://git@localhost:/git/project . 2>&1 | head -20\n\nif [ -f index.html ]; then\n    echo \"\"\n    echo \"=== SSH Clone Successful ===\"\n    echo \"Files in cloned repo:\"\n    ls -la\nfi\n","is_backgrounded":false,"task_type":"local_bash","uuid":"f7f06e62-419e-421f-8b6d-b6bd62e73733","session_id":"068589a5-7fe5-4416-b3ed-a9887fd0d13a"}
