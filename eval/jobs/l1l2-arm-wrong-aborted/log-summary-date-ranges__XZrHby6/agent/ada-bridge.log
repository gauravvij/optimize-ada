[claude:event system] {"type":"system","subtype":"task_started","task_id":"bk5a7m63r","tool_use_id":"toolu_01H8aWGhHmL5BDYGHwprE8p1","description":"cat > /tmp/analyze_logs.sh << 'EOF'\n#!/bin/bash\n\n# Reference date: 2025-08-12\nREF_DATE=\"2025-08-12\"\n\n# Calculate date ranges\nTODAY=$(date -d \"$REF_DATE\" +%Y-%m-%d)\nSEVEN_DAYS_AGO=$(date -d \"$REF_DATE - 6 days\" +%Y-%m-%d)\nTHIRTY_DAYS_AGO=$(date -d \"$REF_DATE - 29 days\" +%Y-%m-%d)\nMONTH_START=$(date -d \"$REF_DATE\" +%Y-%m-01)\n\necho \"Reference date: $REF_DATE\"\necho \"Today: $TODAY\"\necho \"7 days ago: $SEVEN_DAYS_AGO\"\necho \"30 days ago: $THIRTY_DAYS_AGO\"\necho \"Month start: $MONTH_START\"\n\n# Initialize counters\ndeclare -A counters\nfor period in today last_7_days last_30_days month_to_date total; do\n  for severity in ERROR WARNING INFO; do\n    counters[\"${period}_${severity}\"]=0\n  done\ndone\n\n# Process all log files\nfor logfile in /app/logs/*.log; do\n  # Extract date from filename (YYYY-MM-DD_source.log)\n  basename=$(basename \"$logfile\")\n  log_date=\"${basename:0:10}\"  # First 10 chars are YYYY-MM-DD\n  \n  while IFS= read -r line; do\n    # Extract severity from log line [SEVERITY]\n    if [[ $line =~ \\[([A-Z]+)\\] ]]; then\n      severity=\"${BASH_REMATCH[1]}\"\n      \n      # Only count ERROR, WARNING, INFO\n      if [[ \"$severity\" =~ ^(ERROR|WARNING|INFO)$ ]]; then\n        # Update total count\n        ((counters[\"total_${severity}\"]++))\n        \n        # Check if date falls in ranges (string comparison works for YYYY-MM-DD)\n        if [[ \"$log_date\" == \"$TODAY\" ]]; then\n          ((counters[\"today_${severity}\"]++))\n        fi\n        \n        if [[ \"$log_date\" > \"$SEVEN_DAYS_AGO\" ]] || [[ \"$log_date\" == \"$SEVEN_DAYS_AGO\" ]]; then\n          if [[ \"$log_date\" < \"$TODAY\" ]] || [[ \"$log_date\" == \"$TODAY\" ]]; then\n            ((counters[\"last_7_days_${severity}\"]++))\n          fi\n        fi\n        \n        if [[ \"$log_date\" > \"$THIRTY_DAYS_AGO\" ]] || [[ \"$log_date\" == \"$THIRTY_DAYS_AGO\" ]]; then\n          if [[ \"$log_date\" < \"$TODAY\" ]] || [[ \"$log_date\" == \"$TODAY\" ]]; then\n            ((counters[\"last_30_days_${severity}\"]++))\n          fi\n        fi\n        \n        if [[ \"$log_date\" > \"$MONTH_START\" ]] || [[ \"$log_date\" == \"$MONTH_START\" ]]; then\n          if [[ \"$log_date\" < \"$TODAY\" ]] || [[ \"$log_date\" == \"$TODAY\" ]]; then\n            ((counters[\"month_to_date_${severity}\"]++))\n          fi\n        fi\n      fi\n    fi\n  done < \"$logfile\"\ndone\n\n# Output CSV\n{\n  echo \"period,severity,count\"\n  for period in today last_7_days last_30_days month_to_date total; do\n    for severity in ERROR WARNING INFO; do\n      count=${counters[\"${period}_${severity}\"]}\n      echo \"$period,$severity,$count\"\n    done\n  done\n} > /app/summary.csv\n\necho \"Summary CSV created at /app/summary.csv\"\necho \"\"\ncat /app/summary.csv\nEOF\n\nchmod +x /tmp/analyze_logs.sh\n/tmp/analyze_logs.sh\n","is_backgrounded":false,"task_type":"local_bash","uuid":"e2ded6c1-33b3-4af3-b849-19d6922fc433","session_id":"683a1444-f4a9-4745-9c30-a412faae034c"}
