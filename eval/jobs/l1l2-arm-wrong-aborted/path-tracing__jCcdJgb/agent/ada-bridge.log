)\n    print(f\"Max pixel diff (L1): {max_diff}\")\n    print(f\"Mean pixel diff (L1): {sum_diff / (len(pixels1) * 3):.2f}\")\n\nEOF\n","uuid":"df8b10b2-747a-4e3f-861f-f23e895c94a0","session_id":"d8dadbad-fa41-49c6-8f50-bf9dbcbeed9a"}
