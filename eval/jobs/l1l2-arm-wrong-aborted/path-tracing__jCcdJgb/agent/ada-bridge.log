>>6)) & 1\":\n                pred = ((x >> 6) ^ (y_val >> 6)) & 1\n            elif formula_name == \"((x>>6) ^ (y>>7)) & 1\":\n                pred = ((x >> 6) ^ (y_val >> 7)) & 1\n            if pred == expected:\n                matches += 1\n    pct = 100 * matches / len(samples)\n    print(f\"  {formula_name:30s}: {pct:.1f}%\")\n\nEOF\n","uuid":"e253bf69-6771-4748-80da-8d69ec8b6f90","session_id":"d8dadbad-fa41-49c6-8f50-bf9dbcbeed9a"}
