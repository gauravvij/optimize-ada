[claude:event system] {"type":"system","subtype":"task_started","task_id":"b6j8691sc","tool_use_id":"toolu_01DBg2r5BdA9BYABXKoxJTTA","description":"\npython3 << 'EOF'\nimport math\n\ndef read_ppm(filename):\n    with open(filename, 'r') as f:\n        f.readline()\n        f.readline()\n        f.readline()\n        pixels = []\n        for line in f:\n            line = line.strip()\n            if line:\n                r, g, b = map(int, line.split())\n                pixels.append((r, g, b))\n    return pixels\n\npixels_orig = read_ppm('/app/image.ppm')\npixels_recon = read_ppm('/app/reconstructed.ppm')\n\n# Try many different similarity metrics\nn = len(pixels_orig)\n\n# Metric 1: Mean absolute error normalized\nsum_abs_err = sum(abs(o - r) for (r1,g1,b1), (r2,g2,b2) in zip(pixels_orig, pixels_recon) for o, r in [(r1,r2), (g1,g2), (b1,b2)])\nmae = sum_abs_err / (n * 3)\nsim1 = 1 - mae / 255\nprint(f\"1 - MAE/255: {sim1:.6f}\")\n\n# Metric 2: Root mean square error normalized\nsum_sq_err = sum((o - r)**2 for (r1,g1,b1), (r2,g2,b2) in zip(pixels_orig, pixels_recon) for o, r in [(r1,r2), (g1,g2), (b1,b2)])\nrmse = math.sqrt(sum_sq_err / (n * 3))\nsim2 = 1 - rmse / 255\nprint(f\"1 - RMSE/255: {sim2:.6f}\")\n\n# Metric 3: Peak Signal-to-Noise Ratio normalized\npsnr = 20 * math.log10(255 / rmse)\nsim3 = psnr / 50  # Normalize to 0-1, 50 is a good PSNR\nprint(f\"PSNR/50: {sim3:.6f}\")\n\n# Metric 4: Structural Similarity Index (simplified)\n# Just use mean and std correlation\norig_flat = [val for pixel in pixels_orig for val in pixel]\nrecon_flat = [val for pixel in pixels_recon for val in pixel]\nmean_orig = sum(orig_flat) / len(orig_flat)\nmean_recon = sum(recon_flat) / len(recon_flat)\nvar_orig = sum((x - mean_orig)**2 for x in orig_flat) / len(orig_flat)\nvar_recon = sum((x - mean_recon)**2 for x in recon_flat) / len(recon_flat)\ncov = sum((orig_flat[i] - mean_orig) * (recon_flat[i] - mean_recon) for i in range(len(orig_flat))) / len(orig_flat)\nssim = (2 * mean_orig * mean_recon + 1) * (2 * cov + 0.01) / ((mean_orig**2 + mean_recon**2 + 1) * (var_orig + var_recon + 0.01))\nprint(f\"SSIM (simplified): {ssim:.6f}\")\n\n# Metric 5: Cosine similarity\ndot_prod = sum(o * r for (r1,g1,b1), (r2,g2,b2) in zip(pixels_orig, pixels_recon) for o, r in [(r1,r2), (g1,g2), (b1,b2)])\nnorm_orig = math.sqrt(sum(o**2 for (r1,g1,b1), (r2,g2,b2) in zip(pixels_orig, pixels_recon) for o in [r1, g1, b1]))\nnorm_recon = math.sqrt(sum(r**2 for (r1,g1,b1), (r2,g2,b2) in zip(pixels_orig, pixels_recon) for r in [r2, g2, b2]))\nsim5 = dot_prod / (norm_orig * norm_recon)\nprint(f\"Cosine similarity: {sim5:.6f}\")\n\nEOF\n","is_backgrounded":false,"task_type":"local_bash","uuid":"73089105-5714-4d82-8508-96235c0b36e4","session_id":"d8dadbad-fa41-49c6-8f50-bf9dbcbeed9a"}
